<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the native Theme.CollegeGuide.Launch: white window, white system bars with dark
         icons. Shown until Flutter draws its first frame (the CollegeBook splash). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launch_splash_background</item>
        <item name="android:navigationBarColor">@color/launch_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <!-- The window behind the Flutter UI while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
