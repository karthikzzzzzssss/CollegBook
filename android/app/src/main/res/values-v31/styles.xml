<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash, like the native app's, is white with the adaptive
         launcher icon (no separate splash icon). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_splash_background</item>
        <item name="android:statusBarColor">@color/launch_splash_background</item>
        <item name="android:navigationBarColor">@color/launch_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
