<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
>

    <View
        android:id="@+id/view"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:background="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/Header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/icon_color"
        android:paddingVertical="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:src="@drawable/ic_baseline_arrow_back_24"
            android:tint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/DoctorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_16"
            android:text="Video Call"
            app:layout_constraintStart_toEndOf="@id/Back"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white">

            <!-- Stacked video boxes: TOP = receiver (remote), BOTTOM = sender (local) -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/video_stack"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:orientation="vertical"
                android:padding="@dimen/dp_10"
                app:layout_constraintBottom_toTopOf="@id/control_panel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- TOP box: receiver (remote) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/remote_video_view_container"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_0"
                    android:layout_weight="1"
                    android:layout_marginBottom="@dimen/dp_6"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/black"
                    app:cardCornerRadius="@dimen/dp_16"
                    app:cardElevation="0dp"
                    app:strokeColor="#8BC34A"
                    app:strokeWidth="2dp" />

                <!-- BOTTOM box: sender (local) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/local_video_small_container"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_0"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/dp_6"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/black"
                    app:cardCornerRadius="@dimen/dp_16"
                    app:cardElevation="0dp"
                    app:strokeColor="#8BC34A"
                    app:strokeWidth="2dp" />

            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/control_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/control_bottom_margin"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_switch_camera"
                    android:layout_width="@dimen/dp_70"
                    android:layout_height="@dimen/dp_70"
                    android:onClick="onSwitchCameraClicked"
                    android:scaleType="centerCrop"
                    android:src="@drawable/btn_switch_camera" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_mute"
                    android:layout_width="@dimen/dp_70"
                    android:layout_height="@dimen/dp_70"
                    android:layout_marginStart="@dimen/dp_16"
                    android:onClick="onLocalAudioMuteClicked"
                    android:scaleType="centerCrop"
                    android:src="@drawable/btn_unmute" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_call"
                    android:layout_width="@dimen/dp_70"
                    android:layout_height="@dimen/dp_70"
                    android:layout_marginStart="@dimen/dp_16"
                    android:onClick="onCallClicked"
                    android:scaleType="centerCrop"
                    android:src="@drawable/btn_endcall" />
            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>